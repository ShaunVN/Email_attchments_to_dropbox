GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
# Leave DROPBOX_ACCESS_TOKEN empty to use local-save mode. Fill this only if you enable UPLOAD_TO_DROPBOX=true and have the correct Dropbox app scopes.
DROPBOX_ACCESS_TOKEN=
DROPBOX_DEST_FOLDER=/Email_Attachments
LOCAL_DEST_FOLDER="C:\\path\\to\\your\\Dropbox\\folder\\HSBC\\Loan statements"
GMAIL_HOMELOANS_FOLDER=HomeLoans
# By default uploads are disabled to avoid App-folder sandboxing. Set to true to enable Dropbox uploads (requires proper app scopes and token).
UPLOAD_TO_DROPBOX=false
# Optionally set a PDF password if the HSBC statements arrive encrypted and must be opened before saving.
PDF_PASSWORD=
PDF_DECRYPT_ENABLED=false
# Runtime log file for saved/skipped decisions
LOG_FILE=hsbc_statement_log.txt
LAST_PROCESSED_DATE=
STATE_FILE=processed_statements.json
SEARCH_CRITERIA=FROM "HSBC@connect.hsbc.com.au" SUBJECT "Your Monthly HSBC Bank Statement" UNSEEN
